{
  "manifest_version": 3,
  "name": "Instagram DM Studio",
  "version": "0.1.0",
  "description": "Send Instagram DMs from CSV campaigns and scrape qualified leads.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["scrape-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["scrape-interceptor.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Instagram DM Studio",
    "default_popup": "popup.html"
  }
}
